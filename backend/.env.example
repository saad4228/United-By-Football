# Copy to .env and adjust. Every setting is prefixed with UBF_.

UBF_ENV=development

# SQLite by default. For Postgres: pip install -r requirements-postgres.txt and use
# UBF_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ubf
UBF_DATABASE_URL=sqlite+aiosqlite:///./ubf.db

# Real fixtures, live scores, crests and kit colours from ESPN's public scoreboard (no key).
UBF_ESPN_ENABLED=true
# Optional: restrict/extend competitions with ESPN league slugs, e.g. eng.1,esp.1,uefa.champions
# UBF_ESPN_LEAGUES=

# Optional: free YouTube Data API v3 key. Free YouTube streams then link to the exact match video.
# UBF_YOUTUBE_API_KEY=

# Team banners (Wikimedia Commons photos) and club facts (TheSportsDB).
UBF_MEDIA_ENABLED=true
# Wikimedia requires a contact URL or email in the User-Agent; use your site or support address.
# UBF_CONTACT=https://your-site.example/contact

# Optional second, official fixture source: https://www.football-data.org/client/register
# UBF_FOOTBALL_DATA_API_KEY=

# Demo mode replaces real fixtures with a synthetic schedule and enables the bundled
# demo source connectors (served under /mock-sources). Useful offline; off by default.
UBF_DEMO_MODE=false

# Public URL of this backend (used by the demo connectors).
UBF_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Admin dashboard token. If unset, a random token is generated and printed at startup.
# UBF_ADMIN_TOKEN=change-me

# Comma-separated list of allowed frontend origins (only needed if not using the Vite proxy).
UBF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true only when running behind a reverse proxy that sets X-Forwarded-For.
UBF_TRUST_PROXY_HEADERS=false
